// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMINISTRADOR
  ADVOGADO
  ESTAGIARIO
}

model Usuario {
  id_usuario       Int         @id @default(autoincrement())
  nome             String      @db.VarChar(100)
  email            String      @unique @db.VarChar(100)
  senha_hash       String      @db.VarChar(255)
  role             Role        @default(ADVOGADO)
  ativo            Boolean     @default(true)
  data_criacao     DateTime    @default(now())
  data_atualizacao DateTime    @updatedAt

  // Relacionamentos
  agendas          Agenda[]
  documentos       Documento[]
}

model Cliente {
  id_cliente       Int         @id @default(autoincrement())
  nome             String      @db.VarChar(100)
  cpf_cnpj         String      @unique @db.VarChar(20)
  email            String      @db.VarChar(100)
  telefone         String      @db.VarChar(20)
  endereco         String      @db.Text
  data_criacao     DateTime    @default(now())
  data_atualizacao DateTime    @updatedAt

  // Relacionamentos
  processos        Processo[]
}

model Processo {
  id_processo      Int         @id @default(autoincrement())
  numero_processo  String      @unique @db.VarChar(50)
  titulo           String      @db.VarChar(100)
  descricao        String      @db.Text
  data_abertura    DateTime    @db.Date
  status           String      @db.VarChar(50)
  data_criacao     DateTime    @default(now())
  data_atualizacao DateTime    @updatedAt

  // Chave Estrangeira
  id_cliente       Int
  cliente          Cliente     @relation(fields: [id_cliente], references: [id_cliente])

  // Relacionamentos
  prazos           Prazo[]
  documentos       Documento[]
}

model Prazo {
  id_prazo         Int         @id @default(autoincrement())
  descricao        String      @db.VarChar(255)
  data_vencimento  DateTime    @db.Date
  status           String      @db.VarChar(50)
  data_criacao     DateTime    @default(now())
  data_atualizacao DateTime    @updatedAt

  // Chave Estrangeira
  id_processo      Int
  processo         Processo    @relation(fields: [id_processo], references: [id_processo])
}

model Documento {
  id_documento     Int         @id @default(autoincrement())
  nome_arquivo     String      @db.VarChar(255)
  tipo             String      @db.VarChar(50)
  caminho_arquivo  String      @db.Text
  data_upload      DateTime    @default(now())

  // Chaves Estrangeiras
  id_processo      Int
  processo         Processo    @relation(fields: [id_processo], references: [id_processo])
  id_usuario       Int
  usuario          Usuario     @relation(fields: [id_usuario], references: [id_usuario])
}

model Agenda {
  id_agenda        Int         @id @default(autoincrement())
  titulo           String      @db.VarChar(100)
  descricao        String      @db.Text
  data_evento      DateTime    @db.Timestamp()
  tipo             String      @db.VarChar(50)
  data_criacao     DateTime    @default(now())

  // Chave Estrangeira
  id_usuario       Int
  usuario          Usuario     @relation(fields: [id_usuario], references: [id_usuario])
}