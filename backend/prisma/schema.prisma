// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMINISTRADOR
  ADVOGADO
  ESTAGIARIO
}

model Usuario {
  id_usuario       Int         @id @default(autoincrement())
  nome             String      @db.VarChar(100)
  email            String      @unique @db.VarChar(100)
  senha_hash       String      @db.VarChar(255)
  role             Role        @default(ADVOGADO)
  ativo            Boolean     @default(true)
  data_nascimento  DateTime?   @db.Date
  data_criacao     DateTime    @default(now())
  data_atualizacao DateTime    @updatedAt

  // Relacionamentos
  agendas          Agenda[]
  documentos       Documento[]
}

model Cliente {
  id_cliente       Int         @id @default(autoincrement())
  nome             String      @db.VarChar(100)
  cpf_cnpj         String      @unique @db.VarChar(20)
  email            String      @db.VarChar(100)
  telefone         String      @db.VarChar(20)
  endereco         String      @db.Text
  data_nascimento  DateTime?   @db.Date
  data_criacao     DateTime    @default(now())
  data_atualizacao DateTime    @updatedAt

  // Relacionamentos
  processos             Processo[]
  lancamentosFinanceiros LancamentoFinanceiro[]
}

model Processo {
  id_processo      Int         @id @default(autoincrement())
  numero_processo  String      @unique @db.VarChar(50)
  titulo           String      @db.VarChar(100)
  descricao        String      @db.Text
  data_abertura    DateTime    @db.Date
  status           String      @db.VarChar(50)
  data_criacao     DateTime    @default(now())
  data_atualizacao DateTime    @updatedAt

  // Chave Estrangeira
  id_cliente       Int
  cliente          Cliente     @relation(fields: [id_cliente], references: [id_cliente])

  // Relacionamentos
  prazos                 Prazo[]
  documentos             Documento[]
  lancamentosFinanceiros LancamentoFinanceiro[]
}

model Prazo {
  id_prazo         Int         @id @default(autoincrement())
  descricao        String      @db.VarChar(255)
  data_vencimento  DateTime    @db.Date
  hora             String      @default("09:00") @db.VarChar(10)
  tipoCompromisso  String      @default("Prazo Fatal") @db.VarChar(50)
  responsavel      String?     @db.VarChar(100)
  status           String      @db.VarChar(50)
  data_criacao     DateTime    @default(now())
  data_atualizacao DateTime    @updatedAt

  // Chave Estrangeira
  id_processo      Int
  processo         Processo    @relation(fields: [id_processo], references: [id_processo])
}

model Documento {
  id_documento     Int         @id @default(autoincrement())
  nome_arquivo     String      @db.VarChar(255)
  tipo             String      @db.VarChar(50)
  caminho_arquivo  String      @db.Text
  data_upload      DateTime    @default(now())

  // Chaves Estrangeiras
  id_processo      Int
  processo         Processo    @relation(fields: [id_processo], references: [id_processo])
  id_usuario       Int
  usuario          Usuario     @relation(fields: [id_usuario], references: [id_usuario])
}

model Agenda {
  id_agenda        Int         @id @default(autoincrement())
  titulo           String      @db.VarChar(100)
  descricao        String      @db.Text
  data_evento      DateTime    @db.Timestamp()
  tipo             String      @db.VarChar(50)
  data_criacao     DateTime    @default(now())

  // Chave Estrangeira
  id_usuario       Int
  usuario          Usuario     @relation(fields: [id_usuario], references: [id_usuario])
}

enum TipoLancamento {
  RECEITA
  DESPESA
}

enum CategoriaLancamento {
  HONORARIO_CONTRATUAL
  HONORARIO_EXITO
  CONSULTIVO
  CUSTAS_PROCESSUAIS
  OPERACIONAL
  IMPOSTOS
  OUTROS
}

enum StatusLancamento {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}

model LancamentoFinanceiro {
  id               String              @id @default(uuid()) @db.VarChar(50)
  descricao        String              @db.VarChar(255)
  tipo             TipoLancamento
  categoria        CategoriaLancamento @default(HONORARIO_CONTRATUAL)
  valor            Decimal             @db.Decimal(12, 2)
  dataVencimento   DateTime            @db.Date
  dataPagamento    DateTime?           @db.Date
  status           StatusLancamento    @default(PENDENTE)
  formaPagamento   String?             @db.VarChar(50)
  observacoes      String?             @db.Text
  dataCriacao      DateTime            @default(now())
  dataAtualizacao  DateTime            @updatedAt

  // Vínculos Opcionais para Auditoria e Rastreabilidade
  processoId       Int?
  processo         Processo?           @relation(fields: [processoId], references: [id_processo], onDelete: SetNull)

  clienteId        Int?
  cliente          Cliente?            @relation(fields: [clienteId], references: [id_cliente], onDelete: SetNull)
}